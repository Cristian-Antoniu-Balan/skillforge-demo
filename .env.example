# SkillForge — environment variables
# Copy this file to .env.local and fill in values.
# See docs/<integrare>/README.md for setup instructions.

# Mesaj returnat de GET /api/hello — demonstrează variabile server-side (fără NEXT_PUBLIC_)
SKILLFORGE_GREETING=SkillForge

# Anthropic — cheia rămâne pe server; vezi docs/anthropic/README.md
ANTHROPIC_API_KEY=

# OpenAI — cheia rămâne pe server; vezi docs/openai/README.md
OPENAI_API_KEY=

# Auth.js — vezi docs/nextauth/README.md
# AUTH_SECRET = secret (semnează sesiunea; dacă e scurs, regenerează)
AUTH_SECRET=
# AUTH_GITHUB_ID = config (public prin proiectare — apare în URL-ul OAuth)
AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET = secret (dovedește aplicația la GitHub)
AUTH_GITHUB_SECRET=
# AUTH_URL = config (URL canonic în producție, ex. https://….vercel.app)
AUTH_URL=
# Google — pregătit (UI inactiv până enabled: true + valori)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
